# 이 파일을 config/config.yaml 으로 복사한 뒤 값을 채운다.
# 실주소·실키를 이 example에 넣지 말 것. 시크릿 본문은 secrets/ 파일로만.

server:
  host: homelab.example.internal
  port: 22
  user: gostodian

ssh:
  identity_file: secrets/id_ed25519
  known_hosts_file: secrets/known_hosts
  sudo_allowlist: []

# S3에서 채움. 순서는 코드에 하드코딩하지 않는다.
pipeline:
  docker_order: []
  timeouts:
    step: 10m
    reboot: 15m
  # 수집 본문은 점검 머신에서 같은 줄만 합친 뒤 저장한다.
  # max_runes를 비우면 262144글자다. 넘치면 본문을 자르고 이력에 truncated를 남긴다.
  filter:
    max_runes: 262144
  # 본문에 나온 호스트명, IP, 계정, 토큰을 가린다.
  # server.host와 server.user는 여기 없어도 가린다. 이력의 host, user 필드는 남긴다.
  redact:
    hostnames: []
    accounts: []

# 보고서 초안(AI). 코드에 제공자 이름을 두지 않는다.
# api_url은 OpenAI 호환 Chat Completions base다. 운영에서 Claude 쪽으로 둔다.
# 예: Anthropic OpenAI 호환 base. 실제 주소·모델은 점검 머신에서만 채운다.
report:
  api_url: https://api.anthropic.com/v1
  model: claude-sonnet-5-5
  template_file: templates/report_template.md
  timeout: 10m
  max_input_runes: 48000
  max_output_tokens: 8192
  template_hash_file: logs/report_template.sha256

# 보고서는 S3 API로 올린다. 실행 로그와 수집 본문은 올리지 않고 점검 머신에 남긴다.
# MinIO, AWS S3, Cloudflare R2처럼 같은 API를 쓰는 저장소는
# endpoint, bucket, region과 시크릿의 S3_ACCESS_KEY, S3_SECRET_KEY만 바꾼다.
# 예:
#   endpoint: http://127.0.0.1:9000
#   endpoint: https://s3.ap-northeast-2.amazonaws.com
# Google Drive처럼 API가 다른 저장소는 이 블록으로 올라가지 않는다.
# endpoint와 bucket이 둘 다 비어 있으면 올리지 않고 로컬 보고서만 남긴다.
# 키 권한은 PutObject만. 클라이언트 KMS 키는 쓰지 않는다.
s3:
  endpoint: ""
  bucket: ""
  prefix: ""
  region: us-east-1

# 경로는 compose의 GOSTODIAN_SECRETS_FILE 이 있으면 그쪽이 이긴다.
# 파일 줄은 AI_API_KEY, S3_ACCESS_KEY, S3_SECRET_KEY, DISCORD_WEBHOOK.
secrets:
  file: secrets/secrets

# 비어 있으면 VPN 검사를 하지 않는다. 예: wg0
vpn:
  interface: ""
